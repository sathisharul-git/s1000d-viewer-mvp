{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Backend (application)",
      "type": "shell",
      "command": "./gradlew.bat :application:bootRun",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run Webapp",
      "type": "shell",
      "command": "npm.cmd run dev",
      "options": {
        "cwd": "${workspaceFolder}/webapp"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
