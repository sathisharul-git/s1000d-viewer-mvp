{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/s1000d/published-manifest.schema.json",
  "title": "S1000D Published Manifest",
  "type": "object",
  "required": ["modules"],
  "properties": {
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dmId"],
        "properties": {
          "dmId": {
            "type": "string",
            "pattern": "^DMC-[A-Za-z0-9._-]+$"
          },
          "title": { "type": "string" },
          "applicability": {
            "type": "object",
            "properties": {
              "aircraft": { "type": "array", "items": { "type": "string" } },
              "engine": { "type": "array", "items": { "type": "string" } },
              "variant": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          },
          "icns": { "type": "array", "items": { "type": "string" } },
          "dmRefs": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
